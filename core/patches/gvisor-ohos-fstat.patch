 func IsSocketFD(fd int) (bool, error) {
 	var stat unix.Stat_t
 	if err := unix.Fstat(fd, &stat); err != nil {
+		// HarmonyOS VPN descriptors deny fstat even though readv/writev and
+		// non-blocking mode are supported. They are TUN devices, not sockets.
+		if err == unix.EPERM || err == unix.EACCES {
+			return false, nil
+		}
 		return false, fmt.Errorf("unix.Fstat(%v,...) failed: %v", fd, err)
 	}
 	return (stat.Mode & unix.S_IFSOCK) == unix.S_IFSOCK, nil
